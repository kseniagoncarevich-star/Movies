@page "/movies"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Movies.Models
@implements IAsyncDisposable
@inject IDbContextFactory<MoviesContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Index</PageTitle>

<div class="controls">
    <div>
        <h1>Index</h1>

        <p>
            <a href="movies/create" class="btn btn-primary">Create New</a>
        </p>
    </div>

    <div>
        <label for="items-per-page">Элементов на странице:</label>
        <select id="items-per-page" @bind="pagination.ItemsPerPage" class="form-control">
            <option value="3">3</option>
            <option value="5">5</option>
            <option value="8">8</option>
            <option value="13">13</option>
        </select>
    </div>
</div>

<div>
    <QuickGrid Class="table" Items="context.Movie" Pagination="pagination">
        @* <PropertyColumn Property="movie => movie.Title" /> *@
        <TemplateColumn Context="movie"
                        Title="Название фильма"
                        Class="movie-title"
                        Sortable="true"
                        SortBy="sortBy">
            <a href="@($"movies/details?id={movie.ID}")">@movie.Title</a>
        </TemplateColumn>
        <PropertyColumn Class="release-date" Property="movie => movie.ReleaseDate" Sortable="true" />
        <PropertyColumn Class="genre" Property="movie => movie.Genre" />
        @*<PropertyColumn Property="movie => movie.URL" />
        <PropertyColumn Property="movie => movie.Poster" />*@

        @* <TemplateColumn Context="movie">
        <a href="@($"movies/edit?id={movie.ID}")">Edit</a>
        <a href="@($"movies/details?id={movie.ID}")">Details</a>|
        <a href="@($"movies/delete?id={movie.ID}")">Delete</a
        </TemplateColumn> *@
    </QuickGrid>
    <Paginator State="pagination" />
</div>

@code {
    private MoviesContext context = default!;

    GridSort<Movie> sortBy = GridSort<Movie>.ByAscending(m => m.Title);

    PaginationState pagination = new PaginationState { ItemsPerPage = 3 };

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
